# ====================================================================
# Configuración del Backend ULEAM-EVENTOS (Go + Gin)
# ====================================================================

# Puerto del servidor
PORT=8080

# Supabase API & Proyecto
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=[YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY]
SUPABASE_ANON_KEY=[YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY]
SUPABASE_PROJECT_REF=[YOUR_PROJECT_REF]

# Cadena de conexión PostgreSQL (Supabase)
# En Supabase -> Project Settings -> Database -> Connection String (URI / Pooler)
# Reemplaza [YOUR_PROJECT_REF] y [YOUR_PASSWORD] con tus credenciales
DATABASE_URL=postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Claves de Autenticación JWT (RF-002, RNF-004)
JWT_SECRET=uleam_secure_jwt_token_secret_key_2026_ciist
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Orígenes permitidos CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Entorno (development | production)
ENV=development
