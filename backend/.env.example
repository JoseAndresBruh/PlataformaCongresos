# ====================================================================
# Configuracion del Backend ULEAM-EVENTOS (.NET 9 C# ASP.NET Core)
# ====================================================================

# Puerto del servidor
PORT=8080

# Supabase API y Proyecto
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=[YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY]
SUPABASE_ANON_KEY=[YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY]
SUPABASE_PROJECT_REF=[YOUR_PROJECT_REF]

# Cadena de conexion PostgreSQL (Supabase)
# En Supabase -> Project Settings -> Database -> Connection String (URI / Pooler)
# Reemplaza [YOUR_PROJECT_REF] y [YOUR_PASSWORD] con tus credenciales
DATABASE_URL=postgres://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Claves de Autenticacion JWT
JWT_SECRET=uleam_secure_jwt_token_secret_key_2026_ciist
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Origenes permitidos CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://micongreso.vercel.app

# Entorno (development | production)
ENV=development

# Credenciales de Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=[YOUR_GOOGLE_CLIENT_ID].apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=[YOUR_GOOGLE_CLIENT_SECRET]

# Bot de Notificaciones Telegram y WhatsApp (Auditoria Persistente de Pagos)
TELEGRAM_BOT_TOKEN=[YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER]
TELEGRAM_CHAT_ID=[YOUR_TELEGRAM_CHAT_OR_GROUP_ID]
WHATSAPP_PHONE=+593987654321
NOTIFICATION_INTERVAL_MINUTES=15
